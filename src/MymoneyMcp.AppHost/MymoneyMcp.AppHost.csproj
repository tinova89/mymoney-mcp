<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>mymoneymcp-apphost</UserSecretsId>
    <!-- Aspire CLI bundle: DCP and dashboard come from the Aspire CLI, and `dotnet run`, VS Code
         (Aspire extension) and `aspire run` all go through the CLI. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MymoneyMcp.Api\MymoneyMcp.Api.csproj" />
  </ItemGroup>

</Project>
